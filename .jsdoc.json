{
  "sourceType": "module",
  "plugins": ["plugins/markdown"],
  "source": {
    "include": ["src"],
    "includePattern": ".+\\.js(doc|x)?$"
  },
  "opts": {
    "destination": "./docs/api",
    "template": "node_modules/better-docs",
    "recurse": true
  },
  "templates": {
    "default": {
      "includeDate": false,
      "useLongnameInNav": true
    }
  }
}